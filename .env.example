# Environment variables read by the server (set them in your shell or host; there is no .env loader)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
PORT=3000
BASE_URL=http://localhost:3000
# REQUIRED in production (64 hex chars): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORBIT_DATA_KEY=
# Email for confirmation and reset links (needs `npm install`). Without it, localhost prints the links to the console.
SMTP_URL=
MAIL_FROM=Orbit <no-reply@localhost>
# Social sign-in (each button turns on when its keys are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_API_VERSION=v26.0
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Behind exactly one reverse proxy? Set to 1 so rate limits use the real client address.
TRUST_PROXY=
# AI budgets (calls)
ORBIT_AI_DAILY_LIMIT=300
ORBIT_AI_USER_DAILY=30
ORBIT_AI_USER_PER_MIN=6
